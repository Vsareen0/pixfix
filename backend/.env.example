# Copy to .env and adjust.
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-too-at-least-32-characters-long

# Leave unset to use SQLite (backend/pixfix_dev.db) for local development.
# DATABASE_URL=postgresql+psycopg2://pixfix:pixfix@localhost:5432/db_pixfix

# auto | lama | gan | opencv
AI_BACKEND=auto
# auto | cpu | cuda
AI_DEVICE=auto
LAMA_MAX_SIDE=1024

MAX_UPLOAD_MB=20
WORKER_THREADS=2
CORS_ORIGINS=http://localhost:5173
